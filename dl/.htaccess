# Pack delivery. Buyers download a zip built on the fly by pack.php,
# which checks every file against MANIFEST.json before sending.
Options -Indexes

<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow"
</IfModule>

# Old bookmark URL /dl/<token>/PACK.zip -> pack.php
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /dl/
  RewriteRule ^([0-9a-f]{32})/PACK\.zip$ pack.php?t=$1 [L,QSA]
</IfModule>

# Raw data files are only served inside the zip.
<FilesMatch "\.(?i:csv|json|zip)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
