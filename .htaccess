<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|php)$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

<FilesMatch "(secret|store)\.(php|json)$">
  Require all denied
</FilesMatch>

<FilesMatch "^(admin\.html|van\.html|van-sfox\.php|client-secrets\.php)$">
  AuthType Basic
  AuthName "Halfacre desk"
  AuthUserFile /home/u263512999/domains/halfacreresearch.tech/.htpasswd
  Require valid-user
</FilesMatch>
