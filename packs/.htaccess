# TechStack ZIP gate 2026-09-21 — unpaid sold blobs blocked
# Rewrite 403s missing unpaid PACK.zip (FilesMatch alone would 404).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(etf-flow-v2026-09-09|macro-btc-v2026-09-09)/PACK\.zip$ - [F,L]
</IfModule>

<IfModule mod_authz_core.c>
  <FilesMatch "\.(zip|csv|json)$">
    Require all denied
  </FilesMatch>
</IfModule>

ErrorDocument 403 "Pack ZIP gated: purchase required."
