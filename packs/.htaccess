# Unpaid PACK.zip gate. Returns Apache/LiteSpeed 403, not Hostinger's
# missing-document-root platform page. Fulfillment uses /dl tokens (not public).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(etf-flow-v2026-09-09|macro-btc-v2026-09-09)/PACK\.zip$ - [F,L]
</IfModule>

<IfModule mod_authz_core.c>
  <FilesMatch "^PACK\.zip$">
    Require all denied
  </FilesMatch>
</IfModule>

ErrorDocument 403 "Pack ZIP gated: purchase required."
